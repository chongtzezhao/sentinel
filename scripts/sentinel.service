# TEMPLATE, not a live unit.
# scripts/install.sh rewrites the four paths below (WorkingDirectory,
# EnvironmentFile, ExecStart, ReadWritePaths) with sed and installs the result
# to /etc/systemd/system/sentinel.service. The /home/ubuntu paths are
# placeholders on purpose — they never reach a running system. To change the
# deployed unit, edit this file and re-run scripts/install.sh.

[Unit]
Description=Sentinel – Lightweight System Monitor
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/sentinel
# Leading '-' makes the file optional; service still starts if .env is absent.
EnvironmentFile=-/home/ubuntu/sentinel/.env
ExecStart=/home/ubuntu/sentinel/.venv/bin/python -m sentinel run
Restart=on-failure
RestartSec=5
StateDirectory=sentinel
StateDirectoryMode=0750
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

# Optional hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/sentinel

[Install]
WantedBy=multi-user.target
